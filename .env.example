# ==============================================================================
# Environment Variables Template for Tuitora
# ==============================================================================
# Duplicate this file as .env.local for local development, or add these
# keys into your Vercel Project Settings (Project -> Settings -> Environment Variables).
# ==============================================================================

# ------------------------------------------------------------------------------
# MongoDB Database Configuration
# ------------------------------------------------------------------------------
# For Local: mongodb://localhost:27017
# For Vercel / Production: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tuitora_database?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/tuitora_database?retryWrites=true&w=majority

# Database name in MongoDB
DB_NAME=tuitora_database

# ------------------------------------------------------------------------------
# Clerk Authentication
# ------------------------------------------------------------------------------
# Obtain from Clerk Dashboard (https://dashboard.clerk.com) -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="key_from_clerk_dashboard"
CLERK_SECRET_KEY="key_from_clerk_dashboard"

# Obtain from Clerk Dashboard -> Webhooks -> Select/Create Endpoint -> Signing Secret
# (Endpoint URL should point to: https://<your-domain>/api/webhooks/clerk)
CLERK_WEBHOOK_SECRET="key_from_clerk_dashboard"

# ------------------------------------------------------------------------------
# Clerk Routing Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/auth-callback
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding/role
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth-callback
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding/role
